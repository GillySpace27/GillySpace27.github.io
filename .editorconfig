# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{html,css,js,mjs}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

# Written by the Heliogram publish step; the appcasts are signed by Sparkle. Never reformat.
[{heliograph,heliogram}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
